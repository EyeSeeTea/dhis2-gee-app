        "@dhis2/d2-ui-forms": "7.3.3",
        "@dhis2/ui": "7.2.1",
        "@eyeseetea/d2-api": "1.20",
        "@eyeseetea/d2-ui-components": "2.11.0",
        "@eyeseetea/feedback-component": "0.1.3-beta.3",
        "@material-ui/core": "4.12.4",
        "@material-ui/icons": "4.11.3",
